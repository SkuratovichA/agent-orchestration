#!/bin/sh
# Manages the per-repository codebase map cache of this plugin: locates the cache directory outside the repository, says how stale the map is, proposes how to split the repository into modules and stamps the commit a map was built at. The skill agent-orchestration:mapping-codebases says how a map is written and read. Uses git and POSIX tools.
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/hooks/lib.sh"
prog=codebase-map
tab=$(printf '\t')

usage() {
  cat <<'USAGE'
usage: codebase-map dir                   create and print the map directory of the repository holding the working directory
       codebase-map status                map directory, build commit, commits behind HEAD, modules to refresh
       codebase-map status --oneline      the same as one sentence; prints nothing when no map exists
       codebase-map modules [max-files]   propose modules as TSV (path, slug, files) from the tracked files; default max-files is 120
       codebase-map stamp                 record HEAD as the commit the map was built at
The map directory is ${XDG_CACHE_HOME:-$HOME/.cache}/agent-orchestration/maps/<name>-<key>, shared by every worktree of a repository. It holds commit (the build commit), modules.tsv (the module list), modules/<slug>.md and INDEX.md. Changes are counted from the committed history (git diff <commit> HEAD), not from the working tree.
USAGE
}

# Sets mapdir (not created) for the repository holding the working directory.
locate() {
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || fail 1 'not inside a git repository'
  [ -n "$common" ] || fail 1 'not inside a git repository'
  name=$(basename "$(dirname "$common")" | sed 's/[^A-Za-z0-9._-]/-/g')
  key=$(printf %s "$common" | cksum | awk '{print $1}')
  mapdir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-orchestration/maps/$name-$key"
}

# Sets built (none|ok|foreign: the repository does not have the commit), sha (7 characters), behind (commits in c..HEAD), ancestor (1 when the build commit is an ancestor of HEAD, else 0), changed (file list), nchanged, refresh (comma list), nunmapped.
#, sha (7 characters), behind, changed (file list), nchanged, refresh (comma list), nunmapped.
compute() {
  built=none; ancestor=1; sha=; behind=0; changed=; nchanged=0; refresh=; nunmapped=0
  [ -f "$mapdir/commit" ] || return 0
  c=$(sed -n '1{s/[[:space:]]*$//;p;}' "$mapdir/commit")
  sha=$(printf %s "$c" | cut -c1-7)
  case "$c" in
    ''|*[!0-9a-fA-F]*) built=foreign; return 0 ;;
  esac
  # The changed files need no ancestry (git diff <c> HEAD), so a commit that is no ancestor of HEAD (after a rebase or an amend, or stamped from a sibling worktree on another branch) is still usable; only a missing commit object is foreign.
  git rev-parse --verify -q "$c^{commit}" >/dev/null 2>&1 || { built=foreign; return 0; }
  built=ok
  git merge-base --is-ancestor "$c" HEAD >/dev/null 2>&1 || ancestor=0
  behind=$(git rev-list --count "$c..HEAD")
  changed=$(git -c core.quotePath=false diff --no-renames --name-only "$c" HEAD)
  [ -n "$changed" ] && nchanged=$(printf '%s\n' "$changed" | wc -l | tr -d ' ')
  [ "$nchanged" -gt 0 ] || return 0
  # Longest module path that is a prefix of the file; the module . or (root) holds the files at the repository root only.
  mapped=$(printf '%s\n' "$changed" | awk -v mods="$mapdir/modules.tsv" '
    BEGIN {
      FS = "\t"
      while ((getline line < mods) > 0) { split(line, f, "\t"); if (f[1] != "") paths[++n] = f[1] }
    }
    {
      best = ""; found = 0
      for (i = 1; i <= n; i++) {
        p = paths[i]
        if (p == "." || p == "(root)") { if (index($0, "/") == 0 && !found) { best = p; found = 1 }; continue }
        if ($0 == p || index($0, p "/") == 1) { if (!found || length(p) > length(best) || best == "." || best == "(root)") { best = p; found = 1 } }
      }
      if (found) print "M:" best; else print "U:"
    }')
  nunmapped=$(printf '%s\n' "$mapped" | grep -c '^U:')
  refresh=$(printf '%s\n' "$mapped" | sed -n 's/^M://p' | LC_ALL=C sort -u | paste -sd, - | sed 's/,/, /g')
}

cmd_status() {
  oneline=0
  case "$1" in
    '') ;;
    --oneline) oneline=1 ;;
    *) bad_usage "unknown argument to status: $1" ;;
  esac
  if [ "$oneline" = 1 ]; then
    git rev-parse --git-common-dir >/dev/null 2>&1 || exit 0
  fi
  locate
  compute
  if [ "$oneline" = 1 ]; then
    [ "$built" = none ] && exit 0
    case "$built" in
      foreign) printf 'A codebase map of this repository is at %s, built at %s, but this repository does not have that commit; rebuild it.\n' "$mapdir" "$sha" ;;
      *)
        if [ "$nchanged" -eq 0 ]; then tail="nothing changed since"
        else
          list=${refresh:-none}
          tail="$nchanged files changed since, in modules: $list"
          [ "$nunmapped" -gt 0 ] && tail="$tail ($nunmapped outside every module)"
        fi
        [ "$ancestor" = 1 ] || tail="$tail (the build commit is not an ancestor of HEAD)"
        printf 'A codebase map of this repository is at %s, built at %s; %s.\n' "$mapdir" "$sha" "$tail" ;;
    esac
    exit 0
  fi
  printf 'map: %s\n' "$mapdir"
  case "$built" in
    none) printf 'built: none\n' ;;
    foreign) printf 'built: %s, this repository does not have that commit: rebuild\n' "$sha" ;;
    *)
      if [ "$ancestor" = 1 ]; then
        printf 'built: %s (%s commits behind HEAD %s)\n' "$sha" "$behind" "$(git rev-parse --short=7 HEAD)"
      else
        printf 'built: %s (not an ancestor of HEAD %s)\n' "$sha" "$(git rev-parse --short=7 HEAD)"
      fi
      printf 'changed: %s files since the build\n' "$nchanged"
      printf 'refresh: %s\n' "${refresh:-none}"
      [ "$nunmapped" -gt 0 ] && printf 'unmapped: %s changed files outside every module\n' "$nunmapped" ;;
  esac
  exit 0
}

cmd_modules() {
  max=${1:-120}
  case "$max" in ''|*[!0-9]*) bad_usage "max-files must be a positive integer: $max" ;; esac
  [ "$max" -gt 0 ] || bad_usage "max-files must be a positive integer: $max"
  git rev-parse --git-common-dir >/dev/null 2>&1 || fail 1 'not inside a git repository'
  # From the top level: ls-files lists the working directory's subtree, relative to it, and compute reads paths relative to the root.
  top=$(git rev-parse --show-toplevel 2>/dev/null) || fail 1 'not inside a git repository'
  git -C "$top" -c core.quotePath=false ls-files | awk -v max="$max" '
    function slug(s) { gsub(/\//, "-", s); gsub(/[^A-Za-z0-9._-]/, "-", s); return s }
    function emit(path, sl, n) { printf "%s\t%s\t%d\n", path, sl, n }
    function walk(dir, depth,    i, nk, kid) {
      if (total[dir] <= max || depth >= 4 || kidlist[dir] == "") { emit(dir, slug(dir), total[dir]); return }
      if (direct[dir] > 0) emit(dir, slug(dir) "-top", direct[dir])
      nk = split(kidlist[dir], kid, "\n")
      for (i = 1; i <= nk; i++) if (kid[i] != "") walk(kid[i], depth + 1)
    }
    {
      n = split($0, part, "/")
      skip = 0
      for (i = 1; i < n; i++) if (part[i] ~ /^\./ || part[i] == "node_modules") skip = 1
      if (skip) next
      if (n == 1) { rootfiles++; next }
      dir = ""
      for (i = 1; i < n; i++) {
        parent = dir
        dir = (i == 1) ? part[i] : dir "/" part[i]
        total[dir]++
        if (i == 1) tops[dir] = 1
        else if (!((parent SUBSEP dir) in seen)) { seen[parent SUBSEP dir] = 1; kidlist[parent] = kidlist[parent] "\n" dir }
      }
      direct[dir]++
    }
    END {
      if (rootfiles > 0) emit(".", "root", rootfiles)
      for (t in tops) walk(t, 1)
    }' | LC_ALL=C sort -t "$tab" -k1,1
}

cmd_dir() {
  locate
  mkdir -p "$mapdir/modules" || fail 1 "cannot create $mapdir"
  printf '%s\n' "$mapdir"
}

cmd_stamp() {
  locate
  head=$(git rev-parse HEAD 2>/dev/null) || fail 1 'the repository has no commit yet'
  mkdir -p "$mapdir/modules" || fail 1 "cannot create $mapdir"
  printf '%s\n' "$head" > "$mapdir/commit" || fail 1 "cannot write $mapdir/commit"
  printf 'stamped %s\n' "$(printf %s "$head" | cut -c1-7)"
}

case "$1" in
  -h|--help|'') usage; exit 0 ;;
  dir) shift; [ $# -eq 0 ] || bad_usage 'dir takes no arguments'; cmd_dir ;;
  status) shift; cmd_status "$@" ;;
  modules) shift; cmd_modules "$@" ;;
  stamp) shift; [ $# -eq 0 ] || bad_usage 'stamp takes no arguments'; cmd_stamp ;;
  *) bad_usage "unknown subcommand: $1" ;;
esac
